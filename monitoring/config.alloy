logging {
  level = "warn"
}

// Docker socket access removed for security.
// To collect logs from Docker containers, use one of these safer alternatives:
// 1. Docker logging drivers (e.g., loki driver): Configure containers to send logs directly to Loki
// 2. File-based collection: Mount log directories as volumes and use loki.source.file
// 3. Socket proxy: Use tecnativa/docker-socket-proxy to expose only safe Docker API endpoints

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
